# Gemini API Key (needed for Gemma inference via Gemini API)
GEMINI_API_KEY=

# Gemma model identifier
# Recommended: gemma-4-26b-a4b-it (fast), gemma-4-31b-it (higher quality)
GEMMA_MODEL=gemma-4-26b-a4b-it

# Inference configuration
GEMMA_TIMEOUT_SECONDS=40.0
GEMMA_MAX_OUTPUT_TOKENS=1500
GEMMA_TEMPERATURE=0.7

# Service configuration
HOST=0.0.0.0
PORT=8001
DEBUG=true

# Mock Mode (set to true to test offline without consuming API quota)
GEMMA_MOCK_MODE=false
