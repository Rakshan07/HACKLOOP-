# Copy this file to .env and fill in your key. NEVER commit .env to GitHub.
GEMINI_API_KEY=
# Verified Gemma 4 ids on the Gemini API: gemma-4-26b-a4b-it (fast), gemma-4-31b-it (higher quality)
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_TIMEOUT_SECONDS=40
GEMMA_MAX_OUTPUT_TOKENS=1500
# Wikimedia asks every client to identify itself. Put your team name and an email/URL.
WIKI_USER_AGENT=RabbitHole/1.0 (hackathon project; contact: your-email@example.com)
# Comma-separated origins allowed to call the API from a browser (only needed if the frontend is hosted elsewhere)
CORS_ORIGINS=http://localhost:5173
GAME_TTL_SECONDS=7200
MAX_GAMES=500
